---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ContinueReading from '../components/ContinueReading.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage: string;
	heroImageAlt: string;
	heroImageCaption: string;
	readTime: number;
	author: string;
	category: string;
	tags: string[];
	relatedPosts: CollectionEntry<'blog'>[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	heroImageCaption,
	readTime,
	author,
	category,
	tags,
	relatedPosts,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			author={author}
			pubDate={pubDate}
			updatedDate={updatedDate}
			category={category}
			tags={tags}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-frame">
			<Header />
			<main id="main-content" class="article-shell">
				<article class="article-card">
					<header class="article-header">
						<div class="author-line">
							<img src="/images/author.jpg" alt={`Portrait of ${author}`} />
							<div>
								<span>{author}</span>
								<div><FormattedDate date={pubDate} /> <span aria-hidden="true">·</span> {readTime} min read</div>
							</div>
						</div>
						<h1>{title}</h1>
						{updatedDate && <p class="updated">Updated: <FormattedDate date={updatedDate} /></p>}
					</header>
					<figure class="article-figure">
						<img class="article-hero" src={heroImage} alt={heroImageAlt} />
						<figcaption class="sr-only">{heroImageCaption}</figcaption>
					</figure>
					<div class="prose"><slot /></div>
					<a class="back-link" href="/">← All Posts</a>
				</article>
				<ContinueReading posts={relatedPosts} />
			</main>
			<Footer />
		</div>
	</body>
</html>
