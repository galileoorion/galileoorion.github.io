---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage: string;
	readTime: number;
	author: string;
}

const { title, description, pubDate, updatedDate, heroImage, readTime, author } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<div class="site-frame">
			<Header />
			<main class="article-shell">
				<article class="article-card">
					<header class="article-header">
						<div class="author-line">
							<img src="/images/author.jpg" alt="" />
							<div>
								<span>{author}</span>
								<div><FormattedDate date={pubDate} /> <span aria-hidden="true">·</span> {readTime} min read</div>
							</div>
						</div>
						<h1>{title}</h1>
						{updatedDate && <p class="updated">Updated: <FormattedDate date={updatedDate} /></p>}
					</header>
					<img class="article-hero" src={heroImage} alt="" />
					<div class="prose"><slot /></div>
					<a class="back-link" href="/">← All Posts</a>
				</article>
			</main>
			<Footer />
		</div>
	</body>
</html>
